!.yarn/releases
!.yarn/versions

# testing
/coverage
**/.pytest-tmp*/
/.pytest_cache/
.coverage
.ruff_cache/
.mypy_cache/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# local hosting/control-plane metadata
/.openai/

# local Python backend
/.venv/
__pycache__/
*.py[cod]
/server/data/
/server/*.db
/server/*.sqlite*
*.db
*.sqlite
*.sqlite3

# local runtime logs, process markers and generated backend entry
/runtime/*
!/runtime/intent_bao_backend_entry.py
dev-frontend*.log

# ============================================================
# 本地模型与运行文件：一律不进代码仓库（方案 B）
# 仓库只保留代码；llama.cpp 运行库、Qwen3-ASR(mmproj)、FunASR
# 模型随 GitHub Releases / 网盘发布的 models-<版本>.zip 分发，
# 解压到项目根目录即可运行。详见 README「模型准备」。
# ============================================================
