{
  "name": "intent-bao-agent-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vinext/dist/cli.js dev --host 127.0.0.1",
    "build": "node ./node_modules/vinext/dist/cli.js build",
    "start": "node ./node_modules/vinext/dist/cli.js start --host 127.0.0.1",
    "test": "node ./node_modules/vinext/dist/cli.js build && node --test tests/rendered-html.test.mjs tests/auth-api.test.mjs tests/api-client-auth.test.mjs tests/platform-taxonomy.test.mjs tests/view-permissions.test.mjs tests/workflow-guards.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "types:cloudflare": "node ./node_modules/wrangler/bin/wrangler.js types worker/worker-configuration.d.ts --config wrangler.types.jsonc",
    "typecheck:local": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit --incremental false",
    "typecheck:cloudflare": "node ./node_modules/wrangler/bin/wrangler.js types worker/worker-configuration.d.ts --config wrangler.types.jsonc --check && node ./node_modules/typescript/bin/tsc -p tsconfig.cloudflare.json --noEmit --incremental false",
    "typecheck": "pnpm run typecheck:local && pnpm run typecheck:cloudflare",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.5.2",
    "drizzle-orm": "0.45.2",
    "echarts": "^6.1.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
