# 默认值已适用于本地多角色权限演示。不要把真实密钥写入此文件或仓库。
INTENT_BAO_MODEL_ADAPTER=mock
# INTENT_BAO_DATA_DIR=E:/intent-bao-data
# INTENT_BAO_DATABASE_URL=sqlite:///E:/intent-bao-data/database/intent_bao.db

# 可在首次创建数据库前通过进程或用户环境变量设置；不要把真实密码写入本文件。
# 缺失时系统会生成强随机密码，并保存到本机忽略目录供首次登录使用。
# INTENT_BAO_ADMIN_PASSWORD=<首次管理员强密码>
# INTENT_BAO_USER_PASSWORD=<首次普通用户强密码>
